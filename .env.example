# PostgreSQL connection string (cloud-hosted, e.g. Neon, Supabase, Railway, RDS)
# Get this from your database provider's dashboard.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Historical daily ingestion start date (~20 years)
HISTORICAL_START_DATE=2005-01-01

# Overlap window (in days) applied during incremental ingestion to catch corrected data
OVERLAP_DAYS_DAILY=5
OVERLAP_DAYS_HOURLY=2

LOG_LEVEL=INFO
